{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		// Tests only run under Node, so they may use newer built-ins than the published bundle.
		"lib": ["es2022"],
		"types": ["node"]
	},
	"include": [
		"credentials/**/*",
		"nodes/**/*",
		"test/**/*"
	],
	"exclude": [
		"dist/**/*"
	]
}
